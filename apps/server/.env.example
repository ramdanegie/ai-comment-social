DATABASE_URL=postgresql://localhost:5432/replyra_dev
TOKEN_ENCRYPTION_KEY=            # 32 chars

# Meta (App Dashboard → App settings → Basic)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Instagram Login (no Facebook Page): App Dashboard → Instagram use case → API setup with Instagram login.
# Secret only needed to exchange 1h Business Login tokens; dashboard-generated tokens are already 60-day.
META_IG_APP_ID=
META_IG_REDIRECT_URI=
META_IG_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Dev-mode polling (no comment webhooks until app is Live + Advanced Access)
META_POLL_INTERVAL_SEC=300
META_POLL_POSTS=10
# true = log reply/hide instead of calling Meta. Set false to really post.
META_DRY_RUN=true

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3099
WEB_ORIGINS=http://localhost:5173

# AI provider: anthropic | openai | deepseek (empty = rules-only, all comments go to review)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Defaults: anthropic → claude-haiku-4-5, deepseek → deepseek-chat; openai requires an explicit model id
LLM_MODEL_CLASSIFY=
LLM_MODEL_REPLY=
# USD per 1M tokens, for usage metering of models without a built-in price
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
