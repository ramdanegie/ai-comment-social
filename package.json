{
  "name": "replyra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "dev:server": "cd apps/server && bun run dev",
    "dev:worker": "cd apps/server && bun run worker",
    "dev:web": "cd apps/web && bun run dev",
    "db:push": "cd packages/db && bun run db:push",
    "db:seed": "cd packages/db && bun run db:seed",
    "test": "cd apps/server && bun test"
  }
}
